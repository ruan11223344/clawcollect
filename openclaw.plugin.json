{
  "id": "clawcollect",
  "name": "ClawCollect",
  "description": "Hosted form collection bridge for OpenClaw.",
  "version": "0.2.4",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "storage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filePath": {
            "type": "string"
          }
        }
      },
      "online": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "apiUrl": {
            "type": "string"
          },
          "apiToken": {
            "type": "string"
          }
        }
      }
    }
  },
  "uiHints": {
    "storage.filePath": {
      "label": "Store file path",
      "placeholder": "~/.openclaw/plugins/clawcollect/store.json"
    },
    "online.enabled": {
      "label": "Enable online service"
    },
    "online.apiUrl": {
      "label": "Online service API URL",
      "placeholder": "https://collect.dorapush.com"
    },
    "online.apiToken": {
      "label": "Online service API token",
      "placeholder": "cc_tok_..."
    }
  }
}
